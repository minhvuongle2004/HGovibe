rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Người dùng chỉ được đọc/ghi document profile của chính họ
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Subcollection favorites: chỉ user sở hữu mới được đọc/ghi
      match /favorites/{favoriteId} {
        // Đọc: chỉ user sở hữu
        allow read: if request.auth != null && request.auth.uid == userId;
        
        // Tạo mới: chỉ user sở hữu, và phải có destinationId
        allow create: if request.auth != null && 
          request.auth.uid == userId &&
          request.resource.data.keys().hasAll(['destinationId', 'addedAt']) &&
          request.resource.data.destinationId is string;
        
        // Cập nhật: không cho phép (favorites không nên được update)
        allow update: if false;
        
        // Xóa: chỉ user sở hữu
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Reviews: ai cũng đọc được, chỉ chủ review mới được ghi
    match /tour_reviews/{reviewId} {
      // Public read
      allow read: if true;

      // Tạo mới: user phải đăng nhập và trùng userId
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.tourId is string
        && request.resource.data.bookingId is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      // Cập nhật/xóa: chỉ chủ review
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Các collection khác:
    // - Ai cũng đọc được (public read)
    // - Chỉ user đã đăng nhập mới được ghi (web admin, app người dùng...)
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

